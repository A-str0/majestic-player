<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:majestic_player.ui.ViewModels"
        xmlns:models="using:majestic_player.core.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="majestic_player.ui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Majestic Player">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel LastChildFill="True">
        <!-- Управление треком -->
        <Border DockPanel.Dock="Bottom" 
                Height="80" 
                Background="#333333"
                Padding="10">
            <StackPanel Spacing="10"
                        VerticalAlignment="Center">
                <!-- Название трека -->
                <!-- <TextBlock Text="Binding CurrentTrack.Title"
                           Foreground="White"
                           FontSize="16"/> -->
                
                <!-- Прогресс-бар -->
                <!-- <Slider Minimum="0" 
                        Maximum="{Binding TrackDuration.TotalSeconds}"
                        Value="{Binding CurrentPosition}"/> -->
                
                <!-- Кнопки управления -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="20">
                    <Button Content="⏮" Command="{Binding PreviousCommand}"/>
                    <Button Content="PlayPause" 
                            Command="{Binding PlayPauseCommand}"/>
                    <Button Content="⏭" Command="{Binding NextCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel>
                <!-- Панель добавления папок -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Button Command="{Binding AddFolderCommand}" 
                            Content="Add Folder"
                            Margin="0,0,5,0"/>
                </StackPanel>

                <!-- Список треков -->
                <ListBox ItemsSource="{Binding AllTracks}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding $parent.((vm:MainWindowViewModel)DataContext).PlayTrackCommand}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding Title}"
                                    HorizontalContentAlignment="Left"
                                    Width="300"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
