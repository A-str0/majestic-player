<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="SearchTab"
    x:Class="majestic_player.winui.Views.SearchTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:majestic_player.winui.ViewModels" 
    xmlns:models="using:majestic_player.core.Models"
    xmlns:local="using:majestic_player.winui.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SearchTabViewModel}"
    d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <TextBox Text="{x:Bind DataContext.SearchQuery, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                     Width="300" 
                     Margin="0,0,5,0"/>
            <Button Content="Search" 
                    Command="{x:Bind DataContext.SearchCommand}" 
                    Width="100"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
            <!-- Search result list -->
            <ListView 
                x:Name="ResultsList"
                Grid.Row="1" 
                Grid.Column="0"
                Margin="5"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemsSource="{x:Bind DataContext.SearchResults}" 
                ItemClick="{x:Bind DataContext.ResultsList_ItemClick}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TorrentResult">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" Margin="5"/>
                                <TextBlock Text="{Binding Seeders}" Margin="5" Foreground="Green"/>
                                <TextBlock Text="{Binding Leechers}" Margin="5" Foreground="Red"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Torrent files list -->
            <ListView 
                x:Name="Files"
                Grid.Column="1"
                Margin="5"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemsSource="{x:Bind DataContext.TorrentFiles}"
                ItemClick="{x:Bind DataContext.TorrentFiles_ItemClick}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TorrentFileMetadata">
                        <TextBlock Text="{Binding Title}" Margin="5" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
