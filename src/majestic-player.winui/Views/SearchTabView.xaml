<Page
    x:Name="SearchTab"
    x:Class="majestic_player.winui.Views.SearchTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:majestic_player.winui.ViewModels"
    xmlns:models="using:majestic_player.core.Models"
    xmlns:local="using:majestic_player.winui.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    d:DataContext="{d:DesignInstance Type=vm:SearchTabViewModel}"
    mc:Ignorable="d">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <TextBox Text="{x:Bind DataContext.SearchQuery, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                     Width="300" 
                     PlaceholderText="Введите запрос..." 
                     Margin="0,0,5,0"
                     Background="#333333"
                     Foreground="#FFFFFF"/>
            <Button Content="Поиск" 
                    Command="{x:Bind DataContext.SearchCommand}" 
                    Width="100"
                    Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>

        <!-- Список результатов поиска и файлов торрента -->
        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Список торрентов -->
            <ListView 
                x:Name="ResultsList"
                Grid.Column="0"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemsSource="{x:Bind DataContext.SearchResults}" 
                ItemClick="{x:Bind DataContext.ResultsList_ItemClick}"
                Background="#1E1E1E"
                Clip="{x:Null}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TorrentResult">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <SymbolIcon Symbol="Download" Foreground="#CCCCCC" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Seeders}" Foreground="#00FF00" Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding Leechers}" Foreground="#FF0000" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Список файлов торрента -->
            <ListView 
                x:Name="Files"
                Grid.Column="1"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemsSource="{x:Bind DataContext.TorrentFiles}"
                ItemClick="{x:Bind DataContext.TorrentFiles_ItemClick}"
                Background="#1E1E1E">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <SymbolIcon Symbol="Audio" Foreground="#0078D4" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Title}" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>