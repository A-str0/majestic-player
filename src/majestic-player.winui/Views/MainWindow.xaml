<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="majestic_player.winui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:majestic_player.winui.ViewModels"
    xmlns:models="using:majestic_player.core.Models"
    xmlns:local="using:majestic_player.winui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="majestic-player.winui">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Track List -->
        <ScrollViewer Grid.Row="0">
            <StackPanel>
                <!--
                -->
                <Button Content="Add Folder" Command="{x:Bind ViewModel.AddFolderCommand}" Margin="5"/>
                <!--
                -->
                <ListBox ItemsSource="{x:Bind ViewModel.AllTracks}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    CommandParameter="{Binding}"
                                    HorizontalContentAlignment="Left"
                                    Width="300"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer Panel -->
        <Border Grid.Row="1" Background="#333333" Padding="10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Title}" Foreground="White" FontSize="16"/>
                <!--
                <Slider Minimum="0"
                        Maximum="{Binding TrackDuration, Converter={StaticResource TimeSpanConverter}}"
                        Value="{Binding CurrentPosition}"/>
                -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="⏮" Command="{x:Bind ViewModel.PreviousCommand}"/>
                    <Button Content="PlayPause" Command="{x:Bind ViewModel.PlayPauseCommand}"/>
                    <Button Content="⏭" Command="{x:Bind ViewModel.NextCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
